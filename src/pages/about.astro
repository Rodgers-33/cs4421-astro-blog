---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="About Us | Mboga Fresh Tanzania"
			description="Learn about Mboga Fresh Tanzania and our goal of connecting vegetable growers with buyers in Dar es Salaam."
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
	</head>
	<body>
		<Header />
		<main>
			<section class="about-hero">
				<div class="hero-copy">
					<p class="eyebrow">About Mboga Fresh Tanzania</p>
					<h1>
						Bringing fresh produce connections <span
							>closer together.</span>
					</h1>
					<p class="hero-intro">
						We’re building a place where people who grow vegetables
						and people who need them can discover opportunities to
						connect, starting with the vibrant food market of Dar es
						Salaam.
					</p>
					<a class="button" href="/vegetables"
						>Explore vegetables <span aria-hidden="true">→</span></a
					>
				</div>
				<div
					class="hero-photo"
					role="img"
					aria-label="A colourful selection of fresh vegetables"
				>
				</div>
			</section>

			<section class="story section-wrap">
				<div class="story-mark" aria-hidden="true">🌱</div>
				<div class="story-copy">
					<p class="eyebrow eyebrow-green">Our story</p>
					<h2>A simpler way to discover fresh vegetables.</h2>
					<p>
						Mboga Fresh Tanzania is an online vegetable marketplace
						concept designed to help connect growers and suppliers
						with the people and businesses looking for produce. We
						want browsing vegetable varieties and discovering
						potential supply connections to feel clear, welcoming,
						and accessible.
					</p>
					<p>
						Our initial focus is Dar es Salaam, serving a broad
						community that may include households, restaurants,
						hotels, retailers, market vendors, and other food
						businesses.
					</p>
				</div>
			</section>

			<section class="values-section">
				<div class="section-wrap values-inner">
					<div class="section-title">
						<p class="eyebrow eyebrow-green">What guides us</p>
						<h2>Fresh thinking. Stronger connections.</h2>
						<p>
							Our approach is built around making vegetable
							discovery easier and helping buyers and suppliers
							find common ground.
						</p>
					</div>
					<div class="value-grid">
						<article class="value-card">
							<span class="value-icon" aria-hidden="true">🥬</span
							>
							<h3>Fresh produce</h3>
							<p>
								Highlighting familiar vegetables and helping
								visitors learn more about the produce they use
								every day.
							</p>
						</article>
						<article class="value-card">
							<span class="value-icon" aria-hidden="true">🤝</span
							>
							<h3>Useful connections</h3>
							<p>
								Creating a starting point for growers,
								suppliers, households, and food businesses to
								discover one another.
							</p>
						</article>
						<article class="value-card">
							<span class="value-icon" aria-hidden="true">🇹🇿</span
							>
							<h3>Local focus</h3>
							<p>
								Designed with Dar es Salaam and Tanzania’s
								everyday vegetable market in mind.
							</p>
						</article>
					</div>
				</div>
			</section>

			<section class="community section-wrap">
				<div class="community-copy">
					<p class="eyebrow eyebrow-green">Who we have in mind</p>
					<h2>For everyone who brings fresh food to the table.</h2>
					<p>
						From a household planning dinner to a restaurant
						sourcing ingredients, different buyers have different
						needs. We aim to make it easier to explore produce and
						discover potential supplier connections.
					</p>
				</div>
				<div class="audience-list">
					<div>
						<span aria-hidden="true">🏠</span><span
							><strong>Households</strong><small
								>Explore vegetables for everyday meals.</small
							></span>
					</div>
					<div>
						<span aria-hidden="true">🍲</span><span
							><strong>Restaurants and hotels</strong><small
								>Discover produce for menus and kitchens.</small
							></span>
					</div>
					<div>
						<span aria-hidden="true">🧺</span><span
							><strong>Retailers and market vendors</strong><small
								>Explore varieties that customers look for.</small
							></span>
					</div>
					<div>
						<span aria-hidden="true">🌾</span><span
							><strong>Growers and suppliers</strong><small
								>Find out how to express interest in connecting
								with buyers.</small
							></span>
					</div>
				</div>
			</section>

			<section class="closing-cta">
				<p class="eyebrow">Discover Mboga Fresh Tanzania</p>
				<h2>Let’s bring vegetable buyers and suppliers closer.</h2>
				<p>
					Explore our sample vegetable catalogue and learn about the
					produce people use every day.
				</p>
				<a class="button button-light" href="/vegetables"
					>Browse vegetables <span aria-hidden="true">→</span></a
				>
			</section>

			<p class="disclaimer">
				Mboga Fresh Tanzania is presented here as a marketplace concept.
				Listings and images are illustrative; current stock, supplier
				relationships, delivery, and ordering services have not been
				confirmed.
			</p>
		</main>
		<Footer />

		<style>
			:root {
				--green: #176b43;
				--green-dark: #104a30;
				--green-soft: #eaf4ec;
				--ink: #20332a;
				--muted: #637168;
				--line: #e1e9e2;
				--cream: #f8faf6;
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				color: var(--ink);
				background: #fff;
				font-family:
					Inter,
					ui-sans-serif,
					system-ui,
					-apple-system,
					BlinkMacSystemFont,
					"Segoe UI",
					sans-serif;
			}
			.about-hero {
				display: grid;
				grid-template-columns: 1.05fr 0.95fr;
				min-height: 440px;
				background: var(--green-dark);
				color: white;
			}
			.hero-copy {
				align-self: center;
				padding: 64px clamp(24px, 7vw, 100px);
			}
			.eyebrow {
				margin: 0 0 14px;
				font-size: 0.76rem;
				font-weight: 800;
				letter-spacing: 0.14em;
				text-transform: uppercase;
			}
			.about-hero .eyebrow,
			.closing-cta .eyebrow {
				color: #b9e0a5;
			}
			h1,
			h2,
			h3,
			p {
				margin-top: 0;
			}
			h1 {
				max-width: 650px;
				margin-bottom: 20px;
				font-size: clamp(2.5rem, 5vw, 4.5rem);
				line-height: 1.04;
				letter-spacing: -0.045em;
			}
			h1 span {
				color: #b9e0a5;
			}
			.hero-intro {
				max-width: 560px;
				margin-bottom: 28px;
				color: #e2eee5;
				font-size: 1.03rem;
				line-height: 1.8;
			}
			.button {
				display: inline-flex;
				align-items: center;
				gap: 14px;
				min-height: 48px;
				padding: 13px 20px;
				border-radius: 8px;
				color: white;
				background: #24794d;
				text-decoration: none;
				font-weight: 750;
			}
			.button:hover {
				background: #2d8b5b;
			}
			.button-light {
				color: var(--green-dark);
				background: white;
			}
			.button-light:hover {
				color: white;
				background: #24794d;
			}
			.hero-photo {
				min-height: 360px;
				background:
					linear-gradient(
						90deg,
						rgba(16, 74, 48, 0.1),
						rgba(16, 74, 48, 0)
					),
					url("https://images.pexels.com/photos/2255935/pexels-photo-2255935.jpeg?auto=compress&cs=tinysrgb&w=1400")
						center/cover;
			}
			.section-wrap {
				width: min(1120px, calc(100% - 48px));
				margin: 0 auto;
				padding: 78px 0;
			}
			.story {
				display: grid;
				grid-template-columns: 100px 1fr;
				gap: 28px;
				align-items: start;
			}
			.story-mark {
				display: grid;
				place-items: center;
				width: 82px;
				height: 82px;
				border-radius: 22px;
				background: var(--green-soft);
				font-size: 2.2rem;
			}
			.eyebrow-green {
				color: var(--green);
			}
			h2 {
				margin-bottom: 14px;
				font-size: clamp(2rem, 3.5vw, 3rem);
				line-height: 1.12;
				letter-spacing: -0.035em;
			}
			.story-copy h2 {
				max-width: 700px;
			}
			.story-copy p:not(.eyebrow),
			.section-title > p:not(.eyebrow),
			.community-copy > p:not(.eyebrow) {
				color: var(--muted);
				line-height: 1.85;
			}
			.story-copy p:not(.eyebrow) {
				max-width: 800px;
			}
			.values-section {
				background: var(--cream);
			}
			.values-inner {
				padding-top: 72px;
				padding-bottom: 78px;
			}
			.section-title {
				max-width: 700px;
				margin-bottom: 32px;
			}
			.value-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 20px;
			}
			.value-card {
				padding: 26px;
				border: 1px solid var(--line);
				border-radius: 14px;
				background: white;
			}
			.value-icon {
				display: inline-grid;
				place-items: center;
				width: 52px;
				height: 52px;
				margin-bottom: 20px;
				border-radius: 14px;
				background: var(--green-soft);
				font-size: 1.5rem;
			}
			h3 {
				margin-bottom: 10px;
				font-size: 1.2rem;
			}
			.value-card p {
				margin-bottom: 0;
				color: var(--muted);
				line-height: 1.75;
			}
			.community {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 70px;
				align-items: center;
			}
			.audience-list {
				display: grid;
				gap: 12px;
			}
			.audience-list > div {
				display: flex;
				align-items: center;
				gap: 16px;
				padding: 16px;
				border: 1px solid var(--line);
				border-radius: 12px;
			}
			.audience-list > div > span:first-child {
				display: grid;
				place-items: center;
				flex: 0 0 46px;
				height: 46px;
				border-radius: 12px;
				background: var(--green-soft);
				font-size: 1.35rem;
			}
			.audience-list strong,
			.audience-list small {
				display: block;
			}
			.audience-list small {
				margin-top: 5px;
				color: var(--muted);
				line-height: 1.5;
			}
			.closing-cta {
				padding: 64px 24px;
				background: var(--green-dark);
				color: white;
				text-align: center;
			}
			.closing-cta h2 {
				max-width: 740px;
				margin: 0 auto 14px;
			}
			.closing-cta > p:not(.eyebrow) {
				max-width: 620px;
				margin: 0 auto 24px;
				color: #e2eee5;
				line-height: 1.7;
			}
			.disclaimer {
				max-width: 900px;
				margin: 0 auto;
				padding: 22px 24px;
				color: #7b887f;
				font-size: 0.78rem;
				line-height: 1.7;
				text-align: center;
			}
			@media (max-width: 760px) {
				.about-hero {
					grid-template-columns: 1fr;
				}
				.hero-copy {
					padding: 52px 24px;
				}
				.hero-photo {
					min-height: 260px;
				}
				.section-wrap {
					width: calc(100% - 36px);
					padding: 54px 0;
				}
				.story {
					grid-template-columns: 1fr;
					gap: 18px;
				}
				.value-grid {
					grid-template-columns: 1fr;
				}
				.community {
					grid-template-columns: 1fr;
					gap: 26px;
				}
			}
		</style>
	</body>
</html>
