---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

const vegetables = [
    {
        name: "Mchicha",
        category: "leafy",
        description: "A popular leafy green for everyday Tanzanian meals.",
        image: "https://images.pexels.com/photos/2325843/pexels-photo-2325843.jpeg?auto=compress&cs=tinysrgb&w=800",
        alt: "Fresh green leafy vegetables",
    },
    {
        name: "Spinach",
        category: "leafy",
        description:
            "Versatile leafy greens for stews, sides, and family meals.",
        image: "https://images.pexels.com/photos/1359326/pexels-photo-1359326.jpeg?auto=compress&cs=tinysrgb&w=800",
        alt: "Fresh spinach leaves",
    },
    {
        name: "Sukuma Wiki",
        category: "leafy",
        description:
            "A familiar leafy vegetable that pairs well with many dishes.",
        image: "https://images.pexels.com/photos/1656666/pexels-photo-1656666.jpeg?auto=compress&cs=tinysrgb&w=800",
        alt: "Fresh leafy greens",
    },
    {
        name: "Tomatoes",
        category: "fruiting",
        description: "A kitchen staple for sauces, salads, and cooked dishes.",
        image: "https://images.pexels.com/photos/1327838/pexels-photo-1327838.jpeg?auto=compress&cs=tinysrgb&w=800",
        alt: "Fresh red tomatoes",
    },
    {
        name: "Carrots",
        category: "roots",
        description: "Colourful, crunchy vegetables for snacks and meals.",
        image: "https://images.pexels.com/photos/143133/pexels-photo-143133.jpeg?auto=compress&cs=tinysrgb&w=800",
        alt: "Fresh carrots",
    },
    {
        name: "Onions",
        category: "roots",
        description:
            "A versatile ingredient used in countless everyday recipes.",
        image: "https://images.pexels.com/photos/4197447/pexels-photo-4197447.jpeg?auto=compress&cs=tinysrgb&w=800",
        alt: "Fresh onions",
    },
    {
        name: "Cabbage",
        category: "leafy",
        description: "Great for salads, stir-fries, and hearty family dishes.",
        image: "https://images.pexels.com/photos/257794/pexels-photo-257794.jpeg?auto=compress&cs=tinysrgb&w=800",
        alt: "Fresh cabbage",
    },
    {
        name: "Sweet Peppers",
        category: "fruiting",
        description:
            "Bright, crisp peppers to add colour and flavour to meals.",
        image: "https://images.pexels.com/photos/128536/pexels-photo-128536.jpeg?auto=compress&cs=tinysrgb&w=800",
        alt: "Fresh colourful peppers",
    },
];
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title="Explore Vegetables | Mboga Fresh Tanzania"
            description="Explore popular vegetables and discover the kinds of fresh produce buyers and suppliers can connect around in Dar es Salaam, Tanzania."
        />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
    </head>
    <body>
        <Header />

        <main>
            <section class="page-hero">
                <div class="hero-content">
                    <p class="eyebrow">MBoga Fresh Tanzania</p>
                    <h1>
                        Good food starts with <span>fresh vegetables.</span>
                    </h1>
                    <p class="intro">
                        Explore popular vegetables for homes, restaurants,
                        retailers, and food businesses in Dar es Salaam.
                    </p>
                    <a class="button button-light" href="#vegetable-list"
                        >Explore vegetables <span aria-hidden="true">↓</span></a
                    >
                </div>
                <div
                    class="hero-image"
                    role="img"
                    aria-label="A colourful selection of fresh vegetables"
                >
                </div>
            </section>

            <section class="catalogue section-wrap" id="vegetable-list">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow eyebrow-green">
                            Browse the selection
                        </p>
                        <h2>Vegetables to explore</h2>
                        <p class="section-copy">
                            A sample of popular produce. Availability and prices
                            should be confirmed directly with a supplier.
                        </p>
                    </div>
                    <div class="search-wrap">
                        <label for="vegetable-search">Find a vegetable</label>
                        <input
                            id="vegetable-search"
                            type="search"
                            placeholder="Try tomatoes or mchicha…"
                            autocomplete="off"
                        />
                    </div>
                </div>

                <div class="filters" aria-label="Filter vegetables">
                    <button
                        class="filter-button active"
                        type="button"
                        data-filter="all"
                        aria-pressed="true">All vegetables</button
                    >
                    <button
                        class="filter-button"
                        type="button"
                        data-filter="leafy"
                        aria-pressed="false">Leafy greens</button
                    >
                    <button
                        class="filter-button"
                        type="button"
                        data-filter="roots"
                        aria-pressed="false">Roots &amp; bulbs</button
                    >
                    <button
                        class="filter-button"
                        type="button"
                        data-filter="fruiting"
                        aria-pressed="false">Fruit vegetables</button
                    >
                </div>

                <p class="result-count" id="result-count" aria-live="polite">
                    Showing 8 sample vegetables
                </p>

                <div class="vegetable-grid" id="vegetable-grid">
                    {
                        vegetables.map((vegetable) => (
                            <article
                                class="vegetable-card"
                                data-category={vegetable.category}
                                data-name={vegetable.name.toLowerCase()}
                            >
                                <div class="card-image">
                                    <img
                                        src={vegetable.image}
                                        alt={vegetable.alt}
                                        loading="lazy"
                                    />
                                    <span class="sample-tag">
                                        Example listing
                                    </span>
                                </div>
                                <div class="card-content">
                                    <p class="card-category">
                                        {vegetable.category === "leafy"
                                            ? "Leafy greens"
                                            : vegetable.category === "roots"
                                              ? "Roots & bulbs"
                                              : "Fruit vegetables"}
                                    </p>
                                    <h3>{vegetable.name}</h3>
                                    <p>{vegetable.description}</p>
                                    <a class="text-link" href="#supplier-info">
                                        Ask about supply{" "}
                                        <span aria-hidden="true">→</span>
                                    </a>
                                </div>
                            </article>
                        ))
                    }
                </div>
                <p class="no-results" id="no-results" hidden>
                    No vegetables match that search. Try another name or
                    category.
                </p>
            </section>

            <section class="supplier-banner" id="supplier-info">
                <div>
                    <p class="eyebrow">For growers and suppliers</p>
                    <h2>Do you supply fresh vegetables?</h2>
                    <p>
                        Mboga Fresh Tanzania aims to help connect vegetable
                        suppliers with households, restaurants, retailers, and
                        other buyers.
                    </p>
                </div>
                <a
                    class="button button-green"
                    href="mailto:hello@mbogafresh.co.tz?subject=Vegetable%20supplier%20enquiry"
                    >Enquire about supplying <span aria-hidden="true">→</span
                    ></a
                >
            </section>

            <p class="photo-note">
                Photography is illustrative. Images do not represent verified
                stock or current supplier availability.
            </p>
        </main>

        <Footer />

        <script>
            const searchInput =
                document.querySelector<HTMLInputElement>("#vegetable-search");
            const filterButtons = [
                ...document.querySelectorAll<HTMLButtonElement>(
                    ".filter-button",
                ),
            ];
            const cards = [
                ...document.querySelectorAll<HTMLElement>(".vegetable-card"),
            ];
            const resultCount =
                document.querySelector<HTMLElement>("#result-count");
            const noResults =
                document.querySelector<HTMLElement>("#no-results");
            let activeFilter = "all";

            function updateVegetables() {
                const query = searchInput
                    ? searchInput.value.trim().toLowerCase()
                    : "";
                let visible = 0;

                cards.forEach((card) => {
                    const category = card.dataset.category || "";
                    const name = card.dataset.name || "";
                    const text = card.textContent?.toLowerCase() || "";
                    const matchesCategory =
                        activeFilter === "all" || category === activeFilter;
                    const matchesSearch =
                        name.includes(query) || text.includes(query);
                    const show = matchesCategory && matchesSearch;
                    card.hidden = !show;
                    if (show) visible += 1;
                });

                if (resultCount) {
                    resultCount.textContent = `Showing ${visible} sample vegetable${visible === 1 ? "" : "s"}`;
                }
                if (noResults) {
                    noResults.hidden = visible !== 0;
                }
            }

            if (searchInput) {
                searchInput.addEventListener("input", updateVegetables);
            }

            filterButtons.forEach((button) => {
                button.addEventListener("click", () => {
                    activeFilter = button.dataset.filter || "all";
                    filterButtons.forEach((item) => {
                        const isActive = item === button;
                        item.classList.toggle("active", isActive);
                        item.setAttribute("aria-pressed", String(isActive));
                    });
                    updateVegetables();
                });
            });
        </script>

        <style>
            :root {
                --green: #176b43;
                --green-dark: #104a30;
                --green-soft: #eaf4ec;
                --ink: #20332a;
                --muted: #637168;
                --line: #e1e9e2;
                --cream: #f8faf6;
            }

            * {
                box-sizing: border-box;
            }
            body {
                margin: 0;
                color: var(--ink);
                background: #fff;
                font-family:
                    Inter,
                    ui-sans-serif,
                    system-ui,
                    -apple-system,
                    BlinkMacSystemFont,
                    "Segoe UI",
                    sans-serif;
            }
            a {
                color: inherit;
            }
            .page-hero {
                min-height: 430px;
                display: grid;
                grid-template-columns: 1.05fr 0.95fr;
                background: var(--green-dark);
                color: white;
            }
            .hero-content {
                align-self: center;
                padding: 68px clamp(24px, 7vw, 100px);
            }
            .eyebrow {
                margin: 0 0 14px;
                font-size: 0.76rem;
                font-weight: 800;
                letter-spacing: 0.14em;
                text-transform: uppercase;
            }
            .page-hero .eyebrow {
                color: #b9e0c4;
            }
            h1,
            h2,
            h3,
            p {
                margin-top: 0;
            }
            h1 {
                max-width: 620px;
                margin-bottom: 20px;
                font-size: clamp(2.5rem, 5vw, 4.6rem);
                line-height: 1.03;
                letter-spacing: -0.045em;
            }
            h1 span {
                color: #b9e0a5;
            }
            .intro {
                max-width: 540px;
                margin-bottom: 28px;
                color: #e2eee5;
                font-size: 1.05rem;
                line-height: 1.75;
            }
            .button {
                display: inline-flex;
                align-items: center;
                gap: 14px;
                min-height: 48px;
                padding: 13px 20px;
                border-radius: 8px;
                text-decoration: none;
                font-weight: 750;
                transition:
                    transform 0.18s ease,
                    background 0.18s ease;
            }
            .button:hover {
                transform: translateY(-2px);
            }
            .button-light {
                color: var(--green-dark);
                background: white;
            }
            .hero-image {
                min-height: 360px;
                background:
                    linear-gradient(
                        90deg,
                        rgba(16, 74, 48, 0.12),
                        rgba(16, 74, 48, 0)
                    ),
                    url("https://images.pexels.com/photos/2255935/pexels-photo-2255935.jpeg?auto=compress&cs=tinysrgb&w=1400")
                        center/cover;
            }
            .section-wrap {
                width: min(1180px, calc(100% - 48px));
                margin: 0 auto;
                padding: 76px 0 84px;
            }
            .section-heading {
                display: flex;
                justify-content: space-between;
                align-items: end;
                gap: 28px;
                margin-bottom: 28px;
            }
            .eyebrow-green {
                color: var(--green);
            }
            h2 {
                margin-bottom: 12px;
                font-size: clamp(2rem, 3.5vw, 3rem);
                letter-spacing: -0.035em;
                line-height: 1.1;
            }
            .section-copy {
                max-width: 660px;
                margin-bottom: 0;
                color: var(--muted);
                line-height: 1.7;
            }
            .search-wrap {
                flex: 0 1 320px;
            }
            .search-wrap label {
                display: block;
                margin-bottom: 8px;
                font-size: 0.85rem;
                font-weight: 700;
            }
            .search-wrap input {
                width: 100%;
                min-height: 48px;
                padding: 12px 14px;
                border: 1px solid #ccd9ce;
                border-radius: 8px;
                background: #fff;
                color: var(--ink);
                font: inherit;
            }
            .search-wrap input:focus {
                outline: 3px solid #b9e0c4;
                border-color: var(--green);
            }
            .filters {
                display: flex;
                flex-wrap: wrap;
                gap: 10px;
                margin-bottom: 18px;
            }
            .filter-button {
                padding: 10px 15px;
                border: 1px solid var(--line);
                border-radius: 999px;
                background: white;
                color: #405248;
                cursor: pointer;
                font: inherit;
                font-size: 0.9rem;
                font-weight: 700;
            }
            .filter-button:hover,
            .filter-button.active {
                border-color: var(--green);
                background: var(--green);
                color: white;
            }
            .result-count {
                margin-bottom: 18px;
                color: var(--muted);
                font-size: 0.88rem;
            }
            .vegetable-grid {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 22px;
            }
            .vegetable-card {
                overflow: hidden;
                border: 1px solid var(--line);
                border-radius: 14px;
                background: white;
                transition:
                    box-shadow 0.2s ease,
                    transform 0.2s ease;
            }
            .vegetable-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 14px 30px rgba(20, 61, 38, 0.09);
            }
            .vegetable-card[hidden] {
                display: none;
            }
            .card-image {
                position: relative;
                height: 190px;
                overflow: hidden;
                background: var(--green-soft);
            }
            .card-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
                transition: transform 0.3s ease;
            }
            .vegetable-card:hover .card-image img {
                transform: scale(1.04);
            }
            .sample-tag {
                position: absolute;
                top: 12px;
                left: 12px;
                padding: 6px 9px;
                border-radius: 5px;
                background: rgba(255, 255, 255, 0.94);
                color: var(--green-dark);
                font-size: 0.7rem;
                font-weight: 800;
            }
            .card-content {
                padding: 18px;
            }
            .card-category {
                margin-bottom: 7px;
                color: var(--green);
                font-size: 0.75rem;
                font-weight: 800;
                letter-spacing: 0.04em;
                text-transform: uppercase;
            }
            h3 {
                margin-bottom: 9px;
                font-size: 1.25rem;
            }
            .card-content > p:not(.card-category) {
                min-height: 68px;
                margin-bottom: 16px;
                color: var(--muted);
                font-size: 0.91rem;
                line-height: 1.6;
            }
            .text-link {
                display: inline-flex;
                gap: 8px;
                color: var(--green);
                font-size: 0.9rem;
                font-weight: 800;
                text-decoration: none;
            }
            .text-link:hover {
                text-decoration: underline;
            }
            .no-results {
                padding: 28px;
                border-radius: 10px;
                background: var(--cream);
                color: var(--muted);
                text-align: center;
            }
            .supplier-banner {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 32px;
                margin: 0 auto 34px;
                padding: 42px clamp(24px, 6vw, 76px);
                width: min(1180px, calc(100% - 48px));
                border-radius: 18px;
                background: var(--green-soft);
            }
            .supplier-banner .eyebrow {
                color: var(--green);
            }
            .supplier-banner h2 {
                max-width: 580px;
                margin-bottom: 12px;
                font-size: clamp(1.8rem, 3vw, 2.6rem);
            }
            .supplier-banner p:not(.eyebrow) {
                max-width: 660px;
                margin-bottom: 0;
                color: #53665a;
                line-height: 1.7;
            }
            .button-green {
                flex-shrink: 0;
                color: white;
                background: var(--green);
            }
            .button-green:hover {
                background: var(--green-dark);
            }
            .photo-note {
                width: min(1180px, calc(100% - 48px));
                margin: 0 auto 30px;
                color: #7b887f;
                font-size: 0.78rem;
                text-align: center;
            }
            @media (max-width: 980px) {
                .vegetable-grid {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }
                .page-hero {
                    grid-template-columns: 1fr 1fr;
                }
                .hero-content {
                    padding: 48px 28px;
                }
            }
            @media (max-width: 680px) {
                .page-hero {
                    grid-template-columns: 1fr;
                }
                .hero-content {
                    padding: 52px 24px;
                }
                .hero-image {
                    min-height: 250px;
                }
                .section-wrap {
                    width: min(100% - 32px, 1180px);
                    padding: 54px 0;
                }
                .section-heading {
                    align-items: stretch;
                    flex-direction: column;
                }
                .search-wrap {
                    flex-basis: auto;
                }
                .vegetable-grid {
                    gap: 14px;
                }
                .card-image {
                    height: 145px;
                }
                .card-content {
                    padding: 13px;
                }
                .card-content > p:not(.card-category) {
                    min-height: 0;
                    font-size: 0.86rem;
                }
                .supplier-banner {
                    align-items: flex-start;
                    flex-direction: column;
                    width: calc(100% - 32px);
                    padding: 28px 22px;
                }
                .photo-note {
                    width: calc(100% - 32px);
                }
            }
            @media (max-width: 420px) {
                .vegetable-grid {
                    grid-template-columns: 1fr;
                }
                .card-image {
                    height: 210px;
                }
            }
        </style>
    </body>
</html>
